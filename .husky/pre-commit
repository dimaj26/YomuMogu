# 1) Project code quality: ESLint + Ruff on staged files (errors block, warnings don't).
npx lint-staged

# 2) Spec-sync drift guard (spec-kit workflow): staged source code must ship with
#    a spec/doc update in the same commit (specs/**, knowledge/**, the constitution,
#    CONTEXT.md or CHANGELOG.md). Replaces the retired Aethel doc-linter.
#    Escape hatch for an intentionally doc-irrelevant commit: SKIP_SPEC_SYNC=1 git commit ...
echo "=== spec-sync drift guard ==="
if [ -f "./venv/Scripts/python.exe" ]; then
  ./venv/Scripts/python.exe scripts/spec_sync_guard.py || exit 1
elif [ -f "./venv/bin/python" ]; then
  ./venv/bin/python scripts/spec_sync_guard.py || exit 1
else
  python scripts/spec_sync_guard.py || exit 1
fi

# 3) Graph freshness (non-gating): when spec docs are staged, refresh the graph's
#    semantic doc layer in the background (graphify code-only hooks skip it).
#    Always exits 0 — never blocks a commit. See knowledge/graphify-workflow.md.
if [ -f "./venv/Scripts/python.exe" ]; then
  ./venv/Scripts/python.exe scripts/graph_doc_sync.py || true
elif [ -f "./venv/bin/python" ]; then
  ./venv/bin/python scripts/graph_doc_sync.py || true
fi
