# 1) Project code quality: ESLint + Ruff on staged files (errors block, warnings don't).
npx lint-staged

# 2) Aethel AI-workflow + spec verification: knowledge-index integrity, plan/task/
#    walkthrough stage checks, spec-sync drift guard, agent registry, workspace hygiene.
#    Runs alongside (not instead of) lint-staged — they cover disjoint surfaces.
#    Escape hatch for an intentionally spec-irrelevant commit: AETHEL_SKIP_SYNC=1 git commit ...
echo "=== Aethel workflow + spec verification ==="
if [ -f "./venv/Scripts/python.exe" ]; then
  ./venv/Scripts/python.exe prompt_linter.py || exit 1
elif [ -f "./venv/bin/python" ]; then
  ./venv/bin/python prompt_linter.py || exit 1
elif command -v aethel >/dev/null 2>&1; then
  aethel lint . || exit 1
else
  python prompt_linter.py || exit 1
fi

# 3) Graph freshness (non-gating): when spec docs are staged, refresh the graph's
#    semantic doc layer in the background (graphify code-only hooks skip it).
#    Always exits 0 — never blocks a commit. See knowledge/graphify-workflow.md.
if [ -f "./venv/Scripts/python.exe" ]; then
  ./venv/Scripts/python.exe scripts/graph_doc_sync.py || true
elif [ -f "./venv/bin/python" ]; then
  ./venv/bin/python scripts/graph_doc_sync.py || true
fi
