{
  "name": "yomumogu",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/plugins/anki/__tests__/sync.integration.test.ts --config vitest.integration.config.ts",
    "test:integration:gemini": "vitest run src/lib/gemini/__tests__/ --config vitest.integration.config.ts",
    "test:integration:media": "vitest run src/app/api/media/ --config vitest.integration.config.ts",
    "test:anki": "vitest run src/plugins/anki/__tests__/sync.integration.test.ts --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=chromium --project=live",
    "test:e2e:offline": "set E2E_TOKENIZER_DOWN=1&& playwright test --project=offline",
    "transcripts:generate": "node scripts/generate-transcripts.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --no-warn-ignored",
    "*.py": [
      "venv/Scripts/python.exe -m ruff check --fix",
      "venv/Scripts/python.exe -m ruff format"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.11",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-vitest": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
