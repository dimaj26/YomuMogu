    {
      "start": 0,
      "duration": 3,
      "text": "こんにちは、ユミさん。"
    },
    {
      "start": 3,
      "duration": 2.5,
      "text": "ケンさん、こんにちは。"
    },
    {
      "start": 5.5,
      "duration": 2,
      "text": "ユミさん、元気？"
    },
    {
      "start": 7.5,
      "duration": 2.5,
      "text": "はい、元気です。ケンさんも？"
    },
    {
      "start": 10,
      "duration": 2,
      "text": "うん、元気だよ。"
    },
    {
      "start": 12,
      "duration": 4.5,
      "text": "あのね、私の友達の名前はタロウだよ。"
    },
    {
      "start": 16.5,
      "duration": 2,
      "text": "へえ、タロウさん。"
    },
    {
      "start": 18.5,
      "duration": 4,
